# Copy to keystore.properties (gitignored) and fill in. Do not commit the real file
# or upload-keystore.jks — Play Console needs this same key for every update.
#
#   copy keystore.properties.example keystore.properties
#   keytool -genkeypair -v -storetype JKS -keystore upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
