# dependencies
node_modules/

# build output
dist/
build/
ios/
# android/ IS committed (Capacitor native project). Its own android/.gitignore
# keeps build artifacts, .gradle/, local.properties and copied web assets out.

# caches
.vite/
coverage/
*.tsbuildinfo

# local env — never commit real keys
.env*
*.jks
*.keystore
android/keystore.properties
# (no env vars are needed — the game is fully offline)

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*

# test artefacts
/tmp-screenshots/
shot*.png

# agent-local tooling (Claude Code)
.claude/
